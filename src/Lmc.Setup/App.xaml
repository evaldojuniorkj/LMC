<Application x:Class="Lmc.Setup.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="#18362D"/><SolidColorBrush x:Key="Muted" Color="#62736D"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6,0,12"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,13,0,7"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="12,9"/><Setter Property="BorderBrush" Value="#CBD8D1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/><Setter Property="FontSize" Value="15"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Padding" Value="12,9"/><Setter Property="BorderBrush" Value="#CBD8D1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/><Setter Property="FontSize" Value="15"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="15"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,14,0,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="18,11"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="BorderBrush" Value="#CCD9D1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Edge" Property="Opacity" Value="0.83"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Edge" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#126B4B"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#126B4B"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Padding" Value="22"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DEE7E1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
 </Application.Resources>
</Application>
